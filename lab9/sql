CREATE OR REPLACE FUNCTION rental_invoice(p_rental_id INT)
RETURNS TABLE(
    member_name VARCHAR,
    bike_model VARCHAR,
    days INT,
    amount_owed NUMERIC,
    status TEXT
) AS $$
BEGIN
    RETURN QUERY
    SELECT
        m.full_name,
        b.model,
        (COALESCE(r.end_date, CURRENT_DATE) - r.start_date)::INT AS calc_days,
        ROUND(
            (COALESCE(r.end_date, CURRENT_DATE) - r.start_date)::NUMERIC * b.daily_rate,
            2
        ) AS calc_amount,
        CASE
            WHEN r.end_date IS NULL THEN 'OPEN'
            ELSE 'CLOSED'
        END AS rental_status
    FROM rentals r
    JOIN members m ON m.member_id = r.member_id
    JOIN bikes b ON b.bike_id = r.bike_id
    WHERE r.rental_id = p_rental_id;
END;
$$ LANGUAGE plpgsql;

