CREATE OR REPLACE FUNCTION rental_days(p_rental_id INT) RETURNS INT AS
$$
DECLARE
    v_days INT;
BEGIN
    SELECT end_date - start_date
    INTO v_days
    FROM rentals
    WHERE rental_id = p_rental_id;

    RETURN v_days;
END;
$$ LANGUAGE plpgsql;


