CREATE OR REPLACE FUNCTION fee_summary(
    VARIADIC p_fees NUMERIC[],
    OUT total NUMERIC,
    OUT average NUMERIC,
    OUT largest NUMERIC
) AS $$
BEGIN
    SELECT
        SUM(p_fees[i]),
        ROUND(AVG(p_fees[i]), 2),
        MAX(p_fees[i])
    INTO total, average, largest
    FROM generate_subscripts(p_fees, 1) AS g(i);
END;
$$ LANGUAGE plpgsql;

SELECT * FROM fee_summary(13.50, 35.00, 18.50, 31.50);
--Calling fee_summary() with no arguments fails because PostgreSQL requires at least one element to match a VARIADIC

--(a) The id of the row to look up: Use IN because the caller only passes a lookup value into the function without needing it modified or returned.

--(b) A running balance that the caller passes in and expects back updated: Use INOUT because the parameter serves both as an input carrying the initial balance and as an output returning the updated balance.

--(c) A list of station ids of unknown length: Use VARIADIC because it allows the caller to pass a variable number of individual station ID arguments that are automatically collected into an array inside the function.

--(d) Two statistics returned together from one pass over a table: Use OUT (two OUT parameters) because the function needs to return multiple distinct output values simultaneously without requiring any corresponding input values from the caller.


