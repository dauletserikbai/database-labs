CREATE OR REPLACE FUNCTION city_report(p_city VARCHAR)
RETURNS TABLE(
    member_count BIGINT,
    rental_count BIGINT,
    total_revenue NUMERIC
) AS $$
BEGIN
    RETURN QUERY
    SELECT
        COUNT(DISTINCT m.member_id),
        COUNT(r.rental_id),
        COALESCE(SUM(r.fee), 0)
    FROM members m
    LEFT JOIN rentals r ON r.member_id = m.member_id
    WHERE m.city = p_city;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION city_report(p_city VARCHAR, p_from_date DATE)
RETURNS TABLE(
    member_count BIGINT,
    rental_count BIGINT,
    total_revenue NUMERIC
) AS $$
BEGIN
    RETURN QUERY
    SELECT
        COUNT(DISTINCT m.member_id),
        COUNT(r.rental_id),
        COALESCE(SUM(r.fee), 0)
    FROM members m
    LEFT JOIN rentals r
        ON r.member_id = m.member_id
       AND r.start_date >= p_from_date
    WHERE m.city = p_city;
END;
$$ LANGUAGE plpgsql;

--In the two-parameter version, the date condition belongs in the ON clause (not the WHERE clause) because putting r.start_date >= p_from_date in WHERE filters out NULL-extended rows from the LEFT JOIN and turns it into an inner join, dropping members who have no rentals on or after p_from_date. For 'Almaty' with DATE '2025-01-01', putting the date filter in ON keeps all 3 Almaty members (Aisha Nurlanova, Daniyar Serik, Elena Petrova), whereas putting it in WHERE drops Elena Petrova (who has no rentals) and reduces member_count to 2.
