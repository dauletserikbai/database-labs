CREATE OR REPLACE FUNCTION fee_split(
    p_from_date DATE,
    OUT before_total NUMERIC,
    OUT after_total NUMERIC
) AS $$
BEGIN
    SELECT COALESCE(SUM(fee), 0)
    INTO before_total
    FROM rentals
    WHERE start_date < p_from_date;

    DECLARE
        after_total NUMERIC;
    BEGIN
        SELECT COALESCE(SUM(fee), 0)
        INTO after_total
        FROM rentals
        WHERE start_date >= p_from_date;

        fee_split.after_total := after_total;
    END;
END;
$$ LANGUAGE plpgsql;

-- Verify that before_total + after_total equals the total of the whole table
SELECT
    before_total,
    after_total,
    before_total + after_total AS split_sum,
    (SELECT COALESCE(SUM(fee), 0) FROM rentals) AS whole_table_total
FROM fee_split(DATE '2025-01-01');

CREATE OR REPLACE FUNCTION station_load(
    p_station_id INT,
    OUT bikes_parked INT,
    OUT capacity_pct NUMERIC
) AS $$
DECLARE
    v_capacity INT;
BEGIN
    SELECT s.capacity, COUNT(b.bike_id)::INT
    INTO v_capacity, bikes_parked
    FROM stations s
    LEFT JOIN bikes b ON b.station_id = s.station_id
    WHERE s.station_id = p_station_id
    GROUP BY s.capacity;

    IF v_capacity IS NULL THEN
        bikes_parked := NULL;
        capacity_pct := NULL;
    ELSIF v_capacity = 0 THEN
        capacity_pct := 0.0;
    ELSE
        capacity_pct := ROUND((bikes_parked::NUMERIC / v_capacity::NUMERIC) * 100.0, 1);
    END IF;
END;
$$ LANGUAGE plpgsql;

