CREATE OR REPLACE FUNCTION total_fees(p_member_name VARCHAR)
RETURNS NUMERIC AS $$
BEGIN
    RETURN COALESCE(
        (SELECT SUM(r.fee)
         FROM rentals r
         JOIN members m ON m.member_id = r.member_id
         WHERE m.full_name = p_member_name),
        0
    );
END;
$$ LANGUAGE plpgsql;

