create materialized view dept_summary_mv as
select
    d.dept_id,
    d.dept_name,
    COALESCE(e_stats.total_employees, 0) AS total_employees,
    COALESCE(e_stats.total_salaries, 0) AS total_salaries,
    COALESCE(p_stats.total_projects, 0) AS total_projects,
    COALESCE(p_stats.total_project_budget, 0) AS total_project_budget
FROM departments d
LEFT JOIN (
    SELECT dept_id, COUNT(emp_id) AS total_employees, SUM(salary) AS total_salaries
    FROM employees
    GROUP BY dept_id
) e_stats ON d.dept_id = e_stats.dept_id
LEFT JOIN (
    SELECT dept_id, COUNT(project_id) AS total_projects, SUM(budget) AS total_project_budget
    FROM projects
    GROUP BY dept_id
) p_stats ON d.dept_id = p_stats.dept_id
WITH DATA;

